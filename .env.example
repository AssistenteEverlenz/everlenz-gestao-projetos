NEXT_PUBLIC_SUPABASE_URL=
# Projetos novos exibem uma Publishable key. Projetos legados podem usar ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Exclusiva do servidor: necessária para criar usuários da equipe no Auth.
# Nunca use o prefixo NEXT_PUBLIC nesta chave.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: habilita o resumo executivo inteligente; sem ela o sistema usa um resumo técnico local.
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-5.4-mini
NEXT_PUBLIC_APP_URL=http://localhost:3000
